{
    "folders": [
        {
            "name": "Bridge Club Management",
            "path": "."
        },
        {
            "name": "Django App",
            "path": "./bridge_club_management"
        },
        {
            "name": "Documentation",
            "path": "./docs"
        }
    ],
    "settings": {
        "python.defaultInterpreterPath": "~/miniconda3/envs/bridge/bin/python",
        "python.terminal.activateEnvironment": true,
        "terminal.integrated.env.osx": {
            "DJANGO_SETTINGS_MODULE": "bridge_club_management.settings.local"
        },
        "terminal.integrated.env.linux": {
            "DJANGO_SETTINGS_MODULE": "bridge_club_management.settings.local"
        },
        "terminal.integrated.env.windows": {
            "DJANGO_SETTINGS_MODULE": "bridge_club_management.settings.local"
        },
        "python.testing.unittestEnabled": true,
        "python.testing.unittestArgs": [
            "-v",
            "-s",
            "./bridge_club_management",
            "-p",
            "test*.py"
        ],
        "files.exclude": {
            "**/__pycache__": true,
            "**/*.pyc": true,
            "**/staticfiles": true,
            "**/.coverage": true,
            "**/htmlcov": true
        }
    },
    "extensions": {
        "recommendations": [
            "ms-python.python",
            "ms-python.debugpy",
            "batisteo.vscode-django",
            "wholroyd.jinja",
            "bradlc.vscode-tailwindcss",
            "ms-vscode.vscode-json",
            "esbenp.prettier-vscode",
            "ms-python.black-formatter",
            "ms-python.isort",
            "ms-python.flake8"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Quick Start: Run Server",
                "type": "shell",
                "command": "python",
                "args": ["manage.py", "runserver"],
                "options": {
                    "cwd": "${workspaceFolder}/bridge_club_management",
                    "env": {
                        "DJANGO_SETTINGS_MODULE": "bridge_club_management.settings.local"
                    }
                },
                "group": {
                    "kind": "build",
                    "isDefault": true
                },
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "new"
                },
                "problemMatcher": [],
                "detail": "🚀 Start Django development server (local SQLite)"
            }
        ]
    }
}
