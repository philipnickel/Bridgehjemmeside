{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Django: Run Server (Local)",
            "type": "shell",
            "command": "/opt/homebrew/Caskroom/miniconda/base/envs/bridge/bin/python",
            "args": [
                "manage.py",
                "runserver"
            ],
            "options": {
                "cwd": "${workspaceFolder}/bridge_club_management",
                "env": {
                    "DJANGO_SETTINGS_MODULE": "bridge_club_management.settings.local"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Run Django development server with local settings (SQLite)"
        },
