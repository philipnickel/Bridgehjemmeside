{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django: Debug Server",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/bridge_club_management/manage.py",
            "args": [
                "runserver",
                "127.0.0.1:8000"
            ],
            "django": true,
            "autoReload": {
                "enable": true
            },
            "env": {
                "DJANGO_SETTINGS_MODULE": "bridge_club_management.settings.local"
            },
            "cwd": "${workspaceFolder}/bridge_club_management",
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "hidden": false,
                "group": "Django",
                "order": 1
            }
        },
        {
            "name": "Django: Debug Tests",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/bridge_club_management/manage.py",
            "args": [
                "test",
                "--verbosity=2"
            ],
            "django": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "bridge_club_management.settings.local"
            },
            "cwd": "${workspaceFolder}/bridge_club_management",
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "hidden": false,
                "group": "Django",
                "order": 2
            }
        },
        {
            "name": "Django: Debug Model Tests",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/bridge_club_management/manage.py",
            "args": [
                "test",
                "club_management.tests.test_models",
                "--verbosity=2"
            ],
            "django": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "bridge_club_management.settings.local"
            },
            "cwd": "${workspaceFolder}/bridge_club_management",
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "hidden": false,
                "group": "Django",
                "order": 3
            }
        },
        {
            "name": "Django: Debug Form Tests",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/bridge_club_management/manage.py",
            "args": [
                "test",
                "club_management.tests.test_forms",
                "--verbosity=2"
            ],
            "django": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "bridge_club_management.settings.local"
            },
            "cwd": "${workspaceFolder}/bridge_club_management",
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "hidden": false,
                "group": "Django",
                "order": 4
            }
        },
        {
            "name": "Django: Debug Single Test",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/bridge_club_management/manage.py",
            "args": [
                "test",
                "${input:testPath}",
                "--verbosity=2"
            ],
            "django": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "bridge_club_management.settings.local"
            },
            "cwd": "${workspaceFolder}/bridge_club_management",
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "hidden": false,
                "group": "Django",
                "order": 5
            }
        },
        {
            "name": "Django: Debug Management Command",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/bridge_club_management/manage.py",
            "args": [
                "${input:managementCommand}"
            ],
            "django": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "bridge_club_management.settings.local"
            },
            "cwd": "${workspaceFolder}/bridge_club_management",
            "console": "integratedTerminal",
            "justMyCode": false,
            "presentation": {
                "hidden": false,
                "group": "Django",
                "order": 6
            }
        },
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "bridge_club_management.settings.local"
            },
            "presentation": {
                "hidden": false,
                "group": "General",
                "order": 1
            }
        }
    ],
    "inputs": [
        {
            "id": "testPath",
            "description": "Enter the test path (e.g., club_management.tests.test_models.ModelTests.test_customuser_creation)",
            "default": "club_management.tests.test_models",
            "type": "promptString"
        },
        {
            "id": "managementCommand",
            "description": "Enter the Django management command",
            "default": "check",
            "type": "promptString"
        }
    ]
} 